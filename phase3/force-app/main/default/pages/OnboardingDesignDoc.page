<apex:page controller="OnboardingDesignDocController" renderAs="pdf" showHeader="false" sidebar="false" applyHtmlTag="true" applyBodyTag="true">
<head>
    <style type="text/css">
        @page { margin: 1.5cm; }
        body { font-family: Arial, Helvetica, sans-serif; color: #0F172A; font-size: 11pt; }
        h1 { color: #003B70; font-size: 20pt; margin: 0 0 2pt; }
        .sub { color: #64748B; font-size: 10pt; margin-bottom: 18pt; }
        .section { font-size: 9pt; letter-spacing: 1px; text-transform: uppercase; color: #0066B3; margin: 16pt 0 6pt; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; }
        .profile td { padding: 4pt 0; vertical-align: top; }
        .profile .label { color: #64748B; width: 38%; }
        .items th { text-align: left; border-bottom: 1.5pt solid #003B70; padding: 5pt 4pt; color: #003B70; font-size: 9pt; }
        .items td { border-bottom: 0.5pt solid #E8EDF3; padding: 5pt 4pt; }
        .foot { margin-top: 26pt; font-size: 9pt; color: #64748B; }
        .sign { margin-top: 30pt; }
        .sign .line { border-top: 1pt solid #0F172A; width: 55%; margin-top: 34pt; padding-top: 3pt; font-size: 9pt; color: #64748B; }
    </style>
</head>
<body>
    <h1>Onboarding Design &amp; Sign-Off</h1>
    <div class="sub">
        <apex:outputText value="{!checklist.Name}" rendered="{!checklist != null}"/>
        <apex:outputText value=" — {!checklist.Status__c}" rendered="{!checklist != null}"/>
    </div>

    <apex:outputPanel rendered="{!checklist != null}">
        <div class="section">Business Profile</div>
        <table class="profile">
            <tr><td class="label">Legal Entity Name</td><td>{!checklist.Legal_Entity_Name__c}</td></tr>
            <tr><td class="label">DBA Name</td><td>{!checklist.DBA_Name__c}</td></tr>
            <tr><td class="label">Business Address</td><td>{!checklist.Business_Address__c}</td></tr>
            <tr><td class="label">Tax ID / EIN</td><td>{!checklist.Tax_ID__c}</td></tr>
            <tr><td class="label">Date of Incorporation</td><td>{!checklist.Date_of_Incorporation__c}</td></tr>
            <tr><td class="label">Progress</td><td>{!checklist.Progress_Percent__c}%</td></tr>
        </table>

        <div class="section">Onboarding Scope</div>
        <table class="items">
            <tr><th>Task</th><th>Category</th><th>Status</th><th>Due</th></tr>
            <apex:repeat value="{!items}" var="it">
                <tr>
                    <td>{!it.Title__c}</td>
                    <td>{!it.Category__c}</td>
                    <td>{!it.Status__c}</td>
                    <td><apex:outputText value="{!it.Due_Date__c}"/></td>
                </tr>
            </apex:repeat>
        </table>

        <div class="sign">
            <div class="section">Client Sign-Off</div>
            <p>By signing below, the client confirms the onboarding scope and business details above are accurate.</p>
            <div class="line">Authorized Signature</div>
            <div class="line">Printed Name &amp; Date</div>
        </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!checklist == null}">
        <p>No checklist found for the supplied id.</p>
    </apex:outputPanel>

    <div class="foot">Generated by Onboarding Hub. This document is a design / sign-off summary and not a contract.</div>
</body>
</apex:page>
